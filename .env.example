# Copier en .env.local. En local, `npm run db:env` remplit les trois variables Supabase automatiquement.

# Supabase (Paramètres du projet > API). Clé « publishable » : utilisable côté navigateur.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé « secret » : serveur uniquement (invitations, webhooks, tâches). Ne jamais l'exposer au navigateur.
SUPABASE_SECRET_KEY=

# Twilio (envoi des codes SMS / WhatsApp) — uniquement pour un projet Supabase cloud.
# En local, les numéros de test de supabase/config.toml suffisent.
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# Paiement en ligne des parents. Sans valeur : mode démonstration (paiement simulé, aucun argent ne circule).
# Avec « paydunya » : renseigner les trois clés du tableau de bord PayDunya (Intégrez notre API > Configurer).
# Adresse de notification (IPN) à déclarer chez PayDunya : https://<votre-domaine>/api/paiements/paydunya
ONLINE_PAYMENT_PROVIDER=
# « test » (bac à sable) ou « live » (paiements réels).
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# Envoi des notifications par SMS et WhatsApp. Sans valeur : fermé. « log » : démonstration (rien ne part).
# « twilio » : renseigner le compte Twilio ci-dessous (numéros au format +221…, ou le numéro du bac à sable WhatsApp).
NOTIFICATION_CHANNELS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Adresse publique de l'application (liens des SMS) et secret de la tâche quotidienne (Vercel Cron).
APP_URL=https://fama-school.vercel.app
CRON_SECRET=
# Notifications push sur le téléphone (Web Push). Sans clés : fermé (« bientôt disponible » chez les parents).
# Générer une paire de clés une fois : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@famaschool.sn
# Suivi des erreurs (Sentry). Sans valeur : fermé, le SDK n'est pas chargé. Le DSN se trouve dans Sentry,
# Project Settings > Client Keys (DSN). Il n'est pas secret : il peut être lu dans le navigateur.
NEXT_PUBLIC_SENTRY_DSN=
